#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mouse-Layer {
            bindings = <&to 6>;
            key-positions = <15 16>;
        };

        Reset-Layer {
            bindings = <&to 0>;
            key-positions = <5 6>;
        };

        mouse-Layer2 {
            bindings = <&tog 2>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I  &kp RIGHT_PARENTHESIS                                                                      &kp F  &kp S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C  &kp O                                                                                      &kp R  &kp K  &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V  &lt 3 COMMA            &mt LEFT_SHIFT PERIOD                                &kp BACKSPACE  &kp Z  &kp G  &kp B                &kp L                  &kp M
&lt 5 LANGUAGE_2  &kp LG(Z)               &kp LS(LG(Z))                                       &kp SPACE              &mkp MB1  &mouse_layer 4 MB1  &lt 2 ENTER                  &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANGUAGE_1
            >;
        };

        AML {
            bindings = <
&none   &none     &none     &none  &none                                                     &mkp MB4            &mkp MB5             &kp RG(W)             &kp RA(RG(UP))    &kp RG(RC(A))
&none   &none     &none     &none  &none                                                     &kp RS(RC(TAB))     &kp RC(TAB)          &kp RG(T)             &kp RA(RG(DOWN))  &kp RG(LEFT)
&none   &none     &none     &none  &trans  &mkp MB3                      &mkp MB3            &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &kp RS(RG(NUMBER_4))  &kp RS(RG(V))     &kp RG(M)
&trans  &mkp MB4  &mkp MB5                 &mkp MB2  &mkp MB1  &mkp MB1  &mouse_layer 2 MB2                                           &trans                &trans            &trans
            >;
        };

        scroll {
            bindings = <
&kp ESC         &mt HOME END    &kp GLOBE      &kp C           &kp LG(LC(A))                                      &mt HOME END           &kp RS(LEFT)  &kp RS(UP)     &kp RS(RIGHT)  &kp RG(RC(A))
&kp LS(LG(N2))  &kp LS(LG(N1))  &kp LS(LG(X))  &msc SCRL_UP    &kp LG(LEFT)                                       &kp RC(RIGHT_COMMAND)  &kp UP        &kp RS(DOWN)   &none          &kp RG(LEFT)
&kp LS(LG(V))   &kp LS(LG(N4))  &kp LS(LG(F))  &msc SCRL_DOWN  &trans         &mkp MB3                    &trans  &kp LEFT               &kp DOWN      &kp RIGHT      &none          &none
&trans          &kp RG(MINUS)   &kp LG(PLUS)                                  &mkp MB2  &mkp MB1  &trans  &trans                                       &kp RG(MINUS)  &kp RG(PLUS)   &trans
            >;
        };

        number {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N9)    &kp LS(N5)       &kp LS(N0)                                  &kp N7  &kp N8  &kp N9  &kp KP_EQUAL  &kp INTERNATIONAL_3
&kp LS(N3)  &kp LS(N4)  &kp KP_SLASH  &kp KP_MULTIPLY  &kp LS(N6)                                  &kp N4  &kp N5  &kp N6  &kp COLON     &kp TILDE
&kp LS(N7)  &kp LS(N8)  &kp KP_PLUS   &kp KP_MINUS     &trans      &trans                  &trans  &kp N1  &kp N2  &kp N3  &kp N0        &kp PERIOD
&trans      &trans      &kp LG(Y)                                  &trans  &trans  &trans  &trans                  &trans  &trans        &trans
            >;
        };

        symbol {
            bindings = <
&kp ESCAPE         &kp LEFT_BRACE  &kp LBKT      &kp RIGHT_BRACE  &kp RBKT                                                  &mkp MB4         &mkp MB5       &kp RG(W)             &kp RS(RC(L))     &kp RG(RC(A))
&kp DOUBLE_QUOTES  &kp SEMICOLON   &kp BSLH      &kp COLON        &kp CARET                                                 &kp RC(RS(TAB))  &kp RC(TAB)    &kp RG(T)             &kp RG(L)         &kp RS(RG(F))
&kp APOS           &kp GRAVE       &kp EQUAL     &kp UNDERSCORE   &kp LESS_THAN  &kp GREATER_THAN                  &kp DEL  &kp RC(LEFT)     &kp RC(RIGHT)  &kp RS(RG(NUMBER_4))  &kp RS(RG(V))     &kp RG(M)
&trans             &kp LG(RBKT)    &kp LG(BSLH)                                  &trans            &trans  &trans  &trans                                   &kp RA(RG(UP))        &kp RA(RG(DOWN))  &trans
            >;
        };

        Bluetooth-Other {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1    &bt BT_SEL 0                                                            &kp RC(RA(R))       &kp RC(RG(LEFT))  &kp RC(RG(UP))     &kp RC(RG(RIGHT))  &none
&none         &none         &none           &none           &none                                                                   &kp RC(RA(RS(UP)))  &kp RC(RA(UP))    &kp RC(RG(DOWN))   &kp C_VOL_DN       &kp C_VOLUME_UP
&none         &none         &none           &bt BT_CLR_ALL  &bt BT_CLR    &none                              &kp RC(RA(BACKSPACE))  &kp RC(RA(LEFT))    &kp RC(RA(DOWN))  &kp RC(RA(RIGHT))  &kp C_BRI_DN       &kp C_BRI_UP
&trans        &bootloader   &studio_unlock                                &trans  &trans  &kp RC(RG(ENTER))  &kp RC(RA(ENTER))                                            &trans             &trans             &trans
            >;
        };

        mouseLayer {
            bindings = <
&none   &none     &none     &none  &none                                                    &mkp MB4         &mkp MB5       &kp RG(W)             &kp RS(RG(NUMBER_2))  &kp RG(RC(A))
&none   &none     &none     &none  &none                                                    &kp RS(RC(TAB))  &kp RC(TAB)    &kp RG(T)             &kp RS(RG(NUMBER_1))  &kp RG(LEFT)
&none   &none     &none     &none  &mo 3  &mkp MB3                      &mkp MB3            &kp RC(LEFT)     &kp RC(RIGHT)  &kp RS(RG(NUMBER_4))  &kp RS(RG(V))         &kp RG(M)
&trans  &mkp MB4  &mkp MB5                &mkp MB2  &mkp MB1  &mkp MB1  &mouse_layer 2 MB2                                  &kp RA(RG(UP))        &kp RA(RG(DOWN))      &trans
            >;
        };
    };
};
