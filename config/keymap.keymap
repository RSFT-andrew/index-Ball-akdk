#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            bindings = <&mo>, <&mkp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mouse-Layer {
            bindings = <&tog 2>;
            key-positions = <16 15>;
        };

        Reset-Layer {
            bindings = <&to 0>;
            key-positions = <5 6>;
        };

        mouse-button1 {
            bindings = <&mkp MB1>;
            key-positions = <28 29>;
        };

        mouse-button {
            bindings = <&mkp MB2>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I  &kp RIGHT_PARENTHESIS                                                                      &lt 2 F  &lt 2 S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C  &kp O                                                                                      &kp R    &kp K    &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V  &lt 4 COMMA            &mt LEFT_SHIFT PERIOD                                &kp BACKSPACE  &kp Z    &kp G    &kp B                &kp L                  &kp M
&lt 6 LANGUAGE_2  &kp LG(Z)               &kp LS(LG(Z))                                       &kp SPACE              &mkp MB1  &mouse_layer 5 MB1  &lt 3 ENTER                      &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANGUAGE_1
            >;
        };

        AML {
            bindings = <
&none   &none     &none     &none  &none                                                     &mkp MB4            &mkp MB5             &none  &none  &kp RG(RC(A))
&none   &none     &none     &none  &none                                                     &kp RS(RC(TAB))     &kp RC(TAB)          &none  &none  &none
&none   &none     &none     &none  &trans  &mkp MB3                      &mkp MB2            &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &none  &none  &none
&trans  &mkp MB4  &mkp MB5                 &mkp MB2  &mkp MB1  &mkp MB1  &mouse_layer 2 MB3                                           &none  &none  &trans
            >;
        };

        scroll {
            bindings = <
&kp ESCAPE            &mt HOME END          &kp GLOBE      &kp C           &kp LG(LC(A))                                          &kp RA(RG(UP_ARROW))  &kp RA(RG(DOWN_ARROW))  &kp RG(W)             &kp RS(RC(L))  &kp RG(RC(A))
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &msc SCRL_UP    &kp LG(LEFT)                                           &kp RS(RC(TAB))       &kp RC(TAB)             &kp RG(T)             &kp RG(L)      &kp RS(RG(F))
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &msc SCRL_DOWN  &trans         &mkp MB3                      &mkp MB3  &kp RC(LEFT_ARROW)    &kp RC(RIGHT_ARROW)     &kp RS(RG(NUMBER_4))  &kp RS(RG(V))  &kp RG(M)
&trans                &mkp MB4              &mkp MB5                                      &mkp MB2  &mkp MB1  &mkp MB1  &trans                                                  &none                 &none          &none
            >;
        };

        mouse-2 {
            bindings = <
&kp ESC         &mt HOME END    &kp GLOBE      &kp C           &kp LG(LC(A))                                      &mt PAGE_UP PAGE_DOWN  &kp RS(LEFT)  &kp RS(UP)      &kp RS(RIGHT)  &kp RG(RC(A))
&kp LS(LG(N2))  &kp LS(LG(N1))  &kp LS(LG(X))  &msc SCRL_UP    &kp LG(LEFT)                                       &kp RC(RIGHT_COMMAND)  &kp UP        &kp RS(DOWN)    &none          &kp RG(LEFT)
&kp LS(LG(V))   &kp LS(LG(N4))  &kp LS(LG(F))  &msc SCRL_DOWN  &trans         &mkp MB3                    &trans  &kp LEFT               &kp DOWN      &kp RIGHT       &none          &none
&trans          &mkp MB4        &mkp MB5                                      &mkp MB2  &mkp MB1  &trans  &trans                                       &msc SCRL_DOWN  &msc SCRL_UP   &none
            >;
        };

        number {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N9)    &kp LS(N5)       &kp LS(N0)                                  &kp N7  &kp N8  &kp N9  &kp KP_EQUAL  &kp INTERNATIONAL_3
&kp LS(N3)  &kp LS(N4)  &kp KP_SLASH  &kp KP_MULTIPLY  &kp LS(N6)                                  &kp N4  &kp N5  &kp N6  &kp COLON     &kp TILDE
&kp LS(N7)  &kp LS(N8)  &kp KP_PLUS   &kp KP_MINUS     &trans      &trans                  &trans  &kp N1  &kp N2  &kp N3  &kp N0        &kp PERIOD
&trans      &trans      &kp LG(Y)                                  &trans  &trans  &trans  &trans                  &trans  &trans        &trans
            >;
        };

        symbol {
            bindings = <
&kp ESCAPE         &kp LEFT_BRACE  &kp LBKT      &kp RIGHT_BRACE  &kp RBKT                                                  &kp RA(RG(UP_ARROW))  &kp RA(RG(DOWN_ARROW))  &kp RG(W)             &kp RS(RC(L))  &kp RG(RC(A))
&kp DOUBLE_QUOTES  &kp SEMICOLON   &kp BSLH      &kp COLON        &kp CARET                                                 &kp RC(RS(TAB))       &kp RC(TAB)             &kp RG(T)             &kp RG(L)      &kp RS(RG(F))
&kp APOS           &kp GRAVE       &kp EQUAL     &kp UNDERSCORE   &kp LESS_THAN  &kp GREATER_THAN                  &kp DEL  &kp RC(LEFT)          &kp RC(RIGHT)           &kp RS(RG(NUMBER_4))  &kp RS(RG(V))  &kp RG(M)
&trans             &kp LG(RBKT)    &kp LG(BSLH)                                  &trans            &trans  &trans  &trans                                                 &msc SCRL_DOWN        &msc SCRL_UP   &trans
            >;
        };

        Bluetooth-Other {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1    &bt BT_SEL 0                                 &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT       &none   &none
&none         &none         &none           &none           &none                                        &kp K_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none   &none
&none         &none         &none           &bt BT_CLR_ALL  &bt BT_CLR    &none                  &trans  &kp C_BRI_DN    &kp C_BRI_UP       &kp RA(RG(UP))   &none   &none
&trans        &bootloader   &studio_unlock                                &none  &trans  &trans  &trans                                     &trans           &trans  &trans
            >;
        };
    };
};
